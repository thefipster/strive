<MudAppBar Elevation="1">
    <MudIconButton
        Icon="@Icons.Material.Filled.Menu"
        Color="Color.Inherit"
        Edge="Edge.Start"
        OnClick="OnToggleDrawer"/>
    <MudIcon Class="ml-3" Icon="@Icons.Material.Outlined.Timeline" Color="Color.Inherit"/>
    <MudLink Style="text-decoration: none;" Color="Color.Inherit" Href="/">
        <span class="ml-4 page-title">Tracker</span>
    </MudLink>
    <MudSpacer/>

    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.body2" Class="mr-2 d-none d-sm-flex">
                @context.User.Identity?.Name
            </MudText>
            @* A plain browser post: clearing the cookie needs a response, which a circuit has not got. *@
            <form method="post" action="/auth/logout">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Outlined.Logout">
                    Sign out
                </MudButton>
            </form>
        </Authorized>
    </AuthorizeView>
</MudAppBar>

@code {
    [Parameter] public EventCallback OnToggleDrawer { get; set; }
}

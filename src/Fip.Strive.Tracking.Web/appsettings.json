{
  "AllowedHosts": "*",
  "Tracking": {
    "DataDirectory": "data",
    "DatabaseFileName": "tracking.db"
  },
  "//Access": "Secrets belong in Access__PasswordHash and Access__ApiKey, never in this file.",
  "Access": {
    "UserName": "admin",
    "PasswordHash": "",
    "ApiKey": "",
    "SessionDays": 14
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tracking-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}

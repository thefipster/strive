<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Cleared first, then exactly one source added. Without the clear, machine- and user-level
      sources still apply, so a build on a machine with an extra feed configured can resolve
      packages from somewhere this repository never named — which is the shape most NuGet
      supply-chain incidents take.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

<MudAppBar Elevation="1">
    <MudIconButton
        Icon="@Icons.Material.Filled.Menu"
        Color="Color.Inherit"
        Edge="Edge.Start"
        OnClick="OnToggleDrawer"/>
    <MudIcon Class="ml-3" Icon="@Icons.Material.Outlined.GpsFixed" Color="Color.Inherit"/>
    <MudLink Style="text-decoration: none;" Color="Color.Inherit" Href="/">
        <span class="ml-4 page-title">Strive</span>
    </MudLink>
    <MudSpacer/>
</MudAppBar>

@code {
    [Parameter] public EventCallback OnToggleDrawer { get; set; }
}

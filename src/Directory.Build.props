<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>TheFipster</Authors>
    <RepositoryUrl>https://github.com/thefipster/strive</RepositoryUrl>
  </PropertyGroup>
  <!--
    The .NET analyzers at their default mode, which both solutions already pass with zero warnings —
    so this costs nothing today and is only ever a net. CI adds -warnaserror; local builds stay
    warnings so a work-in-progress still compiles.

    AnalysisMode is left at the default rather than All on purpose. All would immediately flag the
    EF navigation collections under CA2227, which have to stay settable for the change tracker, and
    a wall of suppressions teaches nobody anything.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <!--
    Central package management pins what this repository asks for; it says nothing about what those
    packages in turn drag in. The lock files pin the whole resolved graph, so a restore is
    reproducible and a transitive change shows up as a reviewable diff rather than as a silent
    difference between two machines. That matters here specifically: two of the findings on this
    branch were transitive — a vulnerable SSH.NET arriving through Testcontainers, and an EF Core
    package resolving at a provider's floor.

    CI restores in locked mode, which fails rather than quietly updating the lock. Locally the lock
    is refreshed by an ordinary restore, so adding a package stages a lock change alongside it.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>

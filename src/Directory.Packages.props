<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    Deliberately small. The harvester generation's package list lives on in
    legacy/harvester/Directory.Packages.props; entries return here only when a
    roadmap step actually needs them.
  -->
  <ItemGroup Label="Frontend">
    <PackageVersion Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>
  <!-- Development-time orchestration only. Nothing outside the AppHost references Aspire. -->
  <ItemGroup Label="Orchestration">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.2" />
  </ItemGroup>
  <!--
    EF Core ships Core, Relational, Design and Sqlite in lockstep, so every one of them is pinned to
    the same patch here. Relational is listed even though nothing references it by name: the Npgsql
    provider asks for [10.0.4, 11.0.0) and NuGet would otherwise settle on that floor, leaving one
    member of the family seven patches behind the rest and tripping MSB3277 across the solution.
    The provider's range covers what is pinned here, so unifying upwards is what it supports.
  -->
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The tracking app's whole database is one file; nothing else here touches SQLite. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!--
      Referenced directly only to get off the 2.1.11 the provider would otherwise drag in, which
      carries GHSA-2m69-gcr7-jv3q. Drop the reference once EF Core's own floor has moved past it.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup Label="Application">
    <!-- Kept in step with EF Core, which transitively demands the same patch level. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.11"
    />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- BackgroundService only. Abstractions, so the application layer stays host-agnostic. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.4" />
    <PackageVersion
      Include="Microsoft.Extensions.Options.ConfigurationExtensions"
      Version="10.0.11"
    />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>

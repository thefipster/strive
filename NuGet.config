<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      NuGet merges every config from the project directory upwards, so this one applies to anything
      built from the repository root as well as to src/NuGet.config. Cleared first, then exactly one
      source added: without the clear, machine- and user-level sources still apply and a build on a
      machine with an extra feed configured can resolve packages from somewhere this repository
      never named.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
